# Build BASE_IMAGE with Python 3.12. Reuse the native model recipe, keeping
# weights outside the image and inference dependencies outside the core prefix.
ARG BASE_IMAGE=alambiq:models-base
# The engine is built in a separate stage that starts from the same Python as the core image,
# so rebuilding the core image reuses the cached engine stage.
ARG ENGINE_BASE=python:3.12-slim-bookworm
FROM ${ENGINE_BASE} AS models
USER root
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev
COPY --from=ghcr.io/astral-sh/uv:0.9.10 /uv /usr/local/bin/uv
COPY environments/protein-representations/environment.yaml /tmp/models.yaml
RUN python -c 'import sys; assert sys.version_info[:2] == (3, 12)' && pip install --no-cache-dir pyyaml
RUN python -c 'import yaml; from pathlib import Path; data=yaml.safe_load(Path("/tmp/models.yaml").read_text()); requirements=next(d["pip"] for d in data["dependencies"] if isinstance(d, dict)); Path("/tmp/models.txt").write_text("\n".join(requirements)+"\n")' \
    && uv venv --python /usr/local/bin/python /opt/models \
    && uv pip install --python /opt/models/bin/python -r /tmp/models.txt

FROM ${BASE_IMAGE} AS runtime
COPY --from=models /opt/models /opt/models
ENV ALAMBIQ_ENV_ESM=/opt/models/bin/python \
    TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor \
    TRITON_CACHE_DIR=/tmp/triton \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1
USER 1000:1000
