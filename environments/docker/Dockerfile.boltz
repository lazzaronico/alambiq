ARG BASE_IMAGE=alambiq:boltz-base
# The engine is built in a separate stage that starts from the same Python as the core image,
# so rebuilding the core image reuses the cached engine stage.
ARG ENGINE_BASE=python:3.12-slim-bookworm
FROM ${ENGINE_BASE} AS engine
USER root
RUN apt-get update && apt-get install -y --no-install-recommends g++
COPY --from=ghcr.io/astral-sh/uv:0.9.10 /uv /usr/local/bin/uv
COPY environments/boltz2/requirements.torch-cu130.txt environments/boltz2/requirements.txt /tmp/
ENV UV_HTTP_TIMEOUT=180
RUN --mount=type=cache,target=/tmp/.cache/uv \
    python -c 'import sys; assert sys.version_info[:2] == (3, 12)' \
    && uv venv --python /usr/local/bin/python /opt/boltz \
    && uv pip install --python /opt/boltz/bin/python -r /tmp/requirements.torch-cu130.txt \
    && uv pip install --python /opt/boltz/bin/python -r /tmp/requirements.txt

FROM ${BASE_IMAGE} AS runtime
COPY --from=engine /opt/boltz /opt/boltz
ENV ALAMBIQ_ENV_BOLTZ=/opt/boltz/bin/python \
    TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor \
    TRITON_CACHE_DIR=/tmp/triton \
    HF_HUB_OFFLINE=1
USER 1000:1000
